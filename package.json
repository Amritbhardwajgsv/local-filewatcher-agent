  },
  "homepage": "https://github.com/Amritbhardwajgsv/local-filewatcher-agent#readme",
  "dependencies": {
    "chokidar": "^4.0.3",
    "dotenv": "^17.4.2",
    "js-yaml": "^4.2.0",
    "vitest": "^4.1.8",
    "winston": "^3.17.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
