{
  "name": "local-agent",
  "version": "1.0.0",
  "description": "A lightweight background service that monitors designated folders on your office machines, detects incoming tender and business documents, and securely uploads them to the cloud processing platform — with zero manual intervention.",
  "main": "dist/agent.js",
  "scripts": {
    "dev": "tsx src/agent.ts",
    "build": "tsc",
    "start": "node dist/agent.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Amritbhardwajgsv/local-filewatcher-agent.git"
  },
